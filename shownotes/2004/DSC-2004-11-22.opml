<?xml version="1.0" encoding="ISO-8859-1"?><!-- OPML generated by Radio UserLand v8.0.9b2 on Mon, 22 Nov 2004 22:28:10 GMT -->
<opml version="1.1">	<head>		<title>DSC-2004-11-22.opml</title>		<dateCreated>Mon, 22 Nov 2004 22:16:35 GMT</dateCreated>		<dateModified>Mon, 22 Nov 2004 22:28:09 GMT</dateModified>		<ownerName>Adam Curry</ownerName>		<ownerEmail>adam@curry.com</ownerEmail>		<expansionState></expansionState>		<vertScrollState>1</vertScrollState>		<windowTop>285</windowTop>		<windowLeft>953</windowLeft>		<windowBottom>889</windowBottom>		<windowRight>1344</windowRight>		</head>	<body>		<outline text="#title &quot;DSC-2004-11-22&quot;"/>		<outline text="UK welcome emails">			<outline text="about BT">				<outline text="New comment posted on your Radio weblog."/>				<outline text=""/>				<outline text="Commenter's name: "/>				<outline text="Philip Miseldine"/>				<outline text=""/>				<outline text="Email address: "/>				<outline text="philip@miseldine.com"/>				<outline text=""/>				<outline text="Commenting on: "/>				<outline text="http://www.blognewsnetwork.com/members/0000001/2004/11/21.html#a6895"/>				<outline text=""/>				<outline text=""/>				<outline text="Hey Adam,  Great Podcast, and great to hear you're liking this lil island :) Just a few quick things:  Be wary of BT Broadband, they cap your usage monthly which isn't a great idea. I use Demon (http://www.demon.co.uk), who let you surf without a cap and have always been really good.  2nd, I have a Freeview card on my PC, so I can record the culture show in high quality on Thursday :)  3rd, erm...I forget, oh yeah, shop at Tesco, they do yummy food :)  4th, come visit Liverpool sometime :)"/>				</outline>			<outline text="con bt">				<outline text="New comment posted on your Radio weblog."/>				<outline text=""/>				<outline text="Commenter's name: "/>				<outline text="Rachel"/>				<outline text=""/>				<outline text="Email address: "/>				<outline text="rachelcgen@gmail.com"/>				<outline text=""/>				<outline text="Commenting on: "/>				<outline text="http://www.blognewsnetwork.com/members/0000001/2004/11/21.html#a6896"/>				<outline text=""/>				<outline text=""/>				<outline text="You may be visiting Starbucks a lot more often if relying on BT to connect you Monday. The ongoing service is good but the ability to connect you was slow 6 months ago - and haven't heard it improving. However, their ability to apologis  e following a complaint continues to surprise; I'd just prefer that they got it right the first time.  Anyway, if you're near the Downs, you're definitely in an area where you should be complaining about the increasing population of the High Street with coffee shops, mobile phone shops and estate agents. But that only works after you've got yourself set up in the first place"/>				</outline>			<outline text="pro bt">				<outline text="New comment posted on your Radio weblog."/>				<outline text=""/>				<outline text="Commenter's name: "/>				<outline text="Martin - Green Dragon"/>				<outline text=""/>				<outline text="Email address: "/>				<outline text="office@greendragononline.co.uk"/>				<outline text=""/>				<outline text="Web site: "/>				<outline text="http://www.greendragononline.co.uk"/>				<outline text=""/>				<outline text=""/>				<outline text="Commenting on: "/>				<outline text="http://www.blognewsnetwork.com/members/0000001/2004/11/21.html#a6896"/>				<outline text=""/>				<outline text=""/>				<outline text="Got to come to the defense of BT on this one- I was connected within 7 days and that including them sending me the modem. I've got to admit I was &quot;pleasently&quot; surprise at their speed."/>				</outline>			</outline>		<outline text="Bongwater" artist="Bongwater" type="artist">			<outline text="Power Of Pussy" album="Power Of Pussy" artist="Bongwater" type="album">				<outline text="Obscene &amp; Pornographic Art" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:09 Obscene &amp; Pornogr#3928FF.mp3" sizeFile="4790775" type="song" whenFileCreated="11/18/04; 8:47:09 AM"/>				</outline>			</outline>		<outline text="radiodaddy.com">			<outline text="Tod's email">				<outline text="From: 	  Tod Maffin &lt;todmaffin@gmail.com&gt;"/>				<outline text="Subject: 	interesting"/>				<outline text="Date: 	November 22, 2004 5:00:17 PM GMT+00:00"/>				<outline text="To: 	  Eric Rice &lt;eric@ericrice.com&gt;, Adam Curry &lt;adam@curry.com&gt;"/>				<outline text="Reply-To: 	  tod@maffin.ca"/>				<outline text=""/>				<outline text="http://www.radiodaddy.com/"/>				<outline text=""/>				<outline text="&quot;This site is being developed as a free service to allow exchange of"/>				<outline text="voiceovers between radio stations worldwide.  The premise of the site"/>				<outline text="is simple.  You need a voiceover recorded, you come to RadioDaddy.com,"/>				<outline text="post your request and a member records your voiceover as an MP3 file"/>				<outline text="and uploads it back to RadioDaddy.   You return to the site, download"/>				<outline text="your free voiceover and wala - new voice on your station!  It's free"/>				<outline text="and all we ask is that you do free voiceovers for our members as"/>				<outline text="well.&quot;"/>				</outline>			<outline text="Site" type="link" url="http://www.radiodaddy.com/"/>			</outline>		<outline text="Virgin Phone experience">			<outline text="Virgin Mobiles" type="link" url="http://www.virginmobile.com/mobile/"/>			</outline>		<outline text="Depressing">			<outline text="To copy phone list of dad friends"/>			</outline>		<outline text="No spliff talk in the UK"/>		<outline text="Podcast Plates">			<outline text="email from Felipe">				<outline text="From: 	  comreturn@enetation.co.uk"/>				<outline text="Subject: 	New Enetation Comment"/>				<outline text="Date: 	November 18, 2004 7:24:30 PM GMT+00:00"/>				<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>				<outline text="Reply-To: 	  comreturn@enetation.co.uk"/>				<outline text=""/>				<outline text="Enetation Comment Notification"/>				<outline text=""/>				<outline text="Direct Link: http://pro.enetation.co.uk/comments.php?user=adamc1999&amp;commentid=6886"/>				<outline text=""/>				<outline text="Comment: Hello Adam,"/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;	Iâ??m a student at UCSD (University of California San Diego), I listen to the DSC everyday, I really enjoy your show, and thanks for all the work that you put into Podcast (creation, promotion and development). Besides all this BOINGING, Iâ??m writing you to let you know that I just bought a new vanity license plate (VLP) that would read â??PODCASTâ??. Last year a bought a very modest and discontinue black 97 Infiniti J30, besides thatâ??s all I could afford and that I have my eye in that kind a car since Infiniti put it in the market more than 10 years ago. "/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;	I was thinking that now that you are moving to England, I assumed that you would need to register your Audi A8, I have no idea how many digits or/and letters you can use in England, but must probably you can do it. About my situation with the VLP, in California you have to pay $41.00 to register and I believe $20.00 for each subsequent year. In the beginning I wanted to use my p!"/>				<outline text="hone number that is 2801500 because itâ??s an easy number to remember, but my wife didnâ??t let me because she was concern that we would be getting calls at home, that was about 6 months ago, Iâ??m just glad that she didnâ??t let do it..."/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;	Please forgive my grammar, Iâ??m from Mexico, and after 15 years in San Diego, Iâ??m still trying ...  "/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;	Thanks again for Podcast and good luck in England"/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;Felipe Valverde"/>				<outline text="&lt;br&gt;"/>				<outline text=""/>				<outline text="Author Name: Felipe Valverde"/>				<outline text="Author IP: 68.7.99.231"/>				<outline text="Author Email: "/>				<outline text="Author Site: "/>				<outline text=""/>				</outline>			</outline>		<outline text="Doug Kaye" artist="Doug Kaye" type="artist">			<outline text="IT Conversations" album="IT Conversations" artist="Doug Kaye" type="album">				<outline text="Announcement 20041113" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:Announcement 20041113.mp3" sizeFile="2346321" type="song" whenFileCreated="11/18/04; 9:12:50 AM"/>				<outline text="ITConversations.com" type="link" url="http://itconversations.com/"/>				</outline>			</outline>		<outline text="About RB and non-RIAA music"/>		<outline text="The Lascivious Biddies" artist="The Lascivious Biddies" type="artist">			<outline text="Get Lucky" album="Get Lucky" artist="The Lascivious Biddies" type="album">				<outline text="8 Famous" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:8 Famous.mp3" sizeFile="6108566" type="song" whenFileCreated="11/17/04; 9:44:19 PM"/>				<outline text="Site" type="link" url="http://lasciviousbiddies.com/"/>				</outline>			</outline>		<outline text="mover - boinng" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:mover.mp3" sizeFile="128757" type="song" whenFileCreated="11/22/04; 9:40:27 AM"/>		<outline text="Bittorrent podcast encoding" type="link" url="http://www.ipodder.org/2004/11/21#a498"/>		<outline text="OPML">			<outline text="email about one big opml">				<outline text="From: 	  comreturn@enetation.co.uk"/>				<outline text="Subject: 	New Enetation Comment"/>				<outline text="Date: 	November 19, 2004 7:30:24 PM GMT+00:00"/>				<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>				<outline text="Reply-To: 	  comreturn@enetation.co.uk"/>				<outline text=""/>				<outline text="Enetation Comment Notification"/>				<outline text=""/>				<outline text="Direct Link: http://pro.enetation.co.uk/comments.php?user=adamc1999&amp;commentid=6885"/>				<outline text=""/>				<outline text="Comment: I love the fact that you\'re putting your show notes in opml - it\'s da bomb!"/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;Just one wish!"/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;Why not abstract your show notes another level (or two) and put them in one big file with &amp;lt;outlines&amp;gt;s for each date (or for each month and then each date within)?  Then it would be a tremendous resource!!!!"/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;Or do you already do this and I just don\'t know about it?"/>				<outline text="&lt;br&gt;"/>				<outline text="&lt;br&gt;Thanks for all you do!"/>				<outline text="&lt;br&gt;kinrowan"/>				<outline text=""/>				<outline text="Author Name: kinrowan"/>				<outline text="Author IP: 216.165.152.226"/>				<outline text="Author Email: "/>				<outline text="Author Site: http://podcastreviews.net"/>				<outline text=""/>				<outline text="Do not reply to this email, as there isnt a human at the other end ;)"/>				<outline text=""/>				<outline text="Thankyou for using enetation."/>				<outline text=""/>				<outline text="Please take a moment to visit our advertisers."/>				<outline text="http://www.ink2order.com/ Discount inkjet supplies to the UK. Next Day Delivery!"/>				<outline text="http://www.saversoftware.co.uk/ Discount software to the UK."/>				<outline text=""/>				<outline text=""/>				<outline text="adam@curry.com"/>				<outline text=""/>				</outline>			</outline>		<outline text="SportsPodcast" type="link" url="http://feeds.feedburner.com/sportspod?m=37"/>		<outline text="Scott Brenner" artist="Scott Brenner" type="artist">			<outline text="opml instead of mp3 in RSS feed" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:curry.mp3" sizeFile="406347" type="song" whenFileCreated="11/18/04; 8:44:38 AM"/>			</outline>		<outline text="How to