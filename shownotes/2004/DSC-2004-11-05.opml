		<outline text="iPodder Lemon 1.1 released">
			<outline text="email">
				<outline text="Hi Adam,"/>
				<outline text=""/>
				<outline text="Just before Bloggercon we have a great announcement to make, iPodder v1.1 is"/>
				<outline text="released for Windows and Macintosh! "/>
				<outline text=""/>
				<outline text="What are the new features of version 1.1?"/>
				<outline text="---------------------------"/>
				<outline text="- Select podcast feeds by using the integrated directory (OPML) inside"/>
				<outline text="iPodder or add feeds manually from the GUI. "/>
				<outline text="- Choose your own download folder! "/>
				<outline text="- The feed list now displays the title, location, downloaded MB and"/>
				<outline text="subscription state for each feed. "/>
				<outline text="- Enhanced download progress feedback. "/>
				<outline text="- Don't want to check all feeds? You can now check just one feed. "/>
				<outline text="- iPodder can now run on startup. "/>
				<outline text="- Advanced options for Power Users. "/>
				<outline text="- Automatic setting of Grouping: Podcast for iTunes/Win users. "/>
				<outline text="- Lots of extra debugging code to make it easier to figure out what went"/>
				<outline text="wrong if a download fails."/>
				<outline text=""/>
				<outline text=""/>
				<outline text="Go get your copy at:"/>
				<outline text="http://ipodder.sourceforge.net/"/>
				<outline text=""/>
				<outline text="Well, enjoy Bloggercon!"/>
				<outline text=""/>
				<outline text="Cheers,"/>
				<outline text="The iPodder team"/>
				</outline>
			</outline>
