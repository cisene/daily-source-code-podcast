		<outline text="Solana Records">
			<outline text="email">
				<outline text="From: 	  John LeBlanc &lt;john@lotvision.org&gt;"/>
				<outline text="Subject: 	You Run Your Mouth"/>
				<outline text="Date: 	November 10, 2004 10:31:09 PM CET"/>
				<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>
				<outline text="Cc: 	  info@solanarecords.com"/>
				<outline text=""/>
				<outline text="Hey Adam,"/>
				<outline text=""/>
				<outline text="We're loving the DSC.  Great job!"/>
				<outline text=""/>
				<outline text="You played &quot;You Run Your Mouth&quot; from the band Delectric on the 10/20/2004 show (about 32 minutes in).  Here's the label that those artists came from.  There's a lot of great music here that you are free to raid: http://www.solanarecords.com/"/>
				<outline text=""/>
				<outline text="If you do end up using a tune in your show, please let us know.  We'd love to brag about it... and you!"/>
				<outline text=""/>
				<outline text="Thanks, enjoy and keep up the great work!"/>
				<outline text=""/>
				<outline text="-John"/>
