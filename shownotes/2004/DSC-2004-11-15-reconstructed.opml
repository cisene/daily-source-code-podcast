		<outline text="BigTone song">
			<outline text="email from Tony Mullins">
				<outline text="From: 	  Tony Mullins &lt;tubefi@gmail.com&gt;"/>
				<outline text="Subject: 	RIAA Free songs!"/>
				<outline text="Date: 	November 12, 2004 6:55:04 AM CET"/>
				<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>
				<outline text="Reply-To: 	  Tony Mullins &lt;tubefi@gmail.com&gt;"/>
				<outline text=""/>
				<outline text="Adam,"/>
				<outline text=""/>
				<outline text="I've been listening to podcasts now for about 3 weeks.  I love it.  I"/>
				<outline text="don't actually own an ipod but with doppler I get up each morning and"/>
				<outline text="listen to all my subscriptions while I work.  It's been an awesome"/>
				<outline text="alternative to inet radio stations.  I get what i want when i want it."/>
				<outline text=""/>
				<outline text="I am in the process of starting an internet radio station and love the"/>
				<outline text="podcast concept.  I am working on adding a daily podcast to go along"/>
				<outline text="with the station."/>
				<outline text=""/>
				<outline text="I said all that to say I am in a band called bigtone (bigtone.org). "/>
				<outline text="Our latest CD has a couple tracks I'd love for you to check out and"/>
				<outline text="possibly play on your RIAA free daily source code show.  The first"/>
				<outline text="link is an instrumental.  I hope you can work it in your show."/>
				<outline text=""/>
				<outline text="ALL the songs are 100% mine and are 100% RIAA free.  Feel free to play"/>
				<outline text="them many times!"/>
				<outline text="Below are links directly to the mp3's."/>
				<outline text=""/>
				<outline text=""/>
				<outline text=""/>
				<outline text="http://btmediagroup.com/audio-bin/bigtone/bigtone-Saad-Ave.-05-Absalom's-Last-Ride.mp3"/>
				<outline text=""/>
				<outline text="http://btmediagroup.com/audio-bin/bigtone/bigtone_Saad%20Ave._Saad_Ave.mp3"/>
				<outline text=""/>
				<outline text="=-="/>
				<outline text="older songs but still good ones!"/>
				<outline text="=-="/>
				<outline text="http://btmediagroup.com/audio-bin/bigtone/bigtone-mercy.mp3"/>
				<outline text=""/>
				<outline text="http://btmediagroup.com/audio-bin/bigtone/bigtone-cool.mp3"/>
				<outline text=""/>
				<outline text="-- "/>
				<outline text="Tony Mullins"/>
				<outline text="Tubefi Studios"/>
				<outline text="www.bigtone.org"/>
				<outline text="www.btmediagroup.com"/>
				<outline text="www.hosting.btmediagroup.com"/>
				<outline text=""/>
				</outline>
