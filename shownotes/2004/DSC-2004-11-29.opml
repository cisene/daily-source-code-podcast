<?xml version="1.0" encoding="ISO-8859-1"?><!-- OPML generated by Radio UserLand v8.0.9b2 on Mon, 29 Nov 2004 17:07:41 GMT -->
<opml version="1.1">	<head>		<title>DSC-2004-11-29.opml</title>		<dateCreated>Mon, 29 Nov 2004 17:07:36 GMT</dateCreated>		<dateModified>Mon, 29 Nov 2004 17:07:41 GMT</dateModified>		<ownerName>Adam Curry</ownerName>		<ownerEmail>adam@curry.com</ownerEmail>		<expansionState>14</expansionState>		<vertScrollState>1</vertScrollState>		<windowTop>89</windowTop>		<windowLeft>1001</windowLeft>		<windowBottom>576</windowBottom>		<windowRight>1383</windowRight>		</head>	<body>		<outline text="#title &quot;DSC-2004-11-29&quot;"/>		<outline text="Show Info">			<outline text="Monday November 29th 2004"/>			<outline text="Studio: A8 in the UK"/>			<outline text="Contact: adam@curry.com"/>			<outline text="Weblog: live.curry.com" type="link" url="http://live.curry.com/"/>			<outline text="Archive: dailysourcecode.com" type="link" url="http://www.dailysourcecode.com/"/>			<outline text="Podcast Feed" type="link" url="http://www.dailysourcecode.com/rss.xml"/>			</outline>		<outline text="maffin dsc sting" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:maffin_dsc_sting.mp3" sizeFile="366758" type="song" whenFileCreated="11/27/04; 9:58:56 PM"/>		<outline text="UK info about tv, power, plugs, light sockets">			<outline text="Dave Raven answers">				<outline text="From: 	  Dave Raven &lt;dave@raven.dj&gt;"/>				<outline text="Subject: 	Don't cut off your plugs"/>				<outline text="Date: 	November 27, 2004 3:59:14 PM GMT+00:00"/>				<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>				<outline text=""/>				<outline text="Hi Adam,"/>				<outline text=""/>				<outline text="It wasn't until I heard Patricia talking about Yvonne on backing vocals did"/>				<outline text="I connect.  I interviewed Yvonne for BFBS Köln way back in the early '80s."/>				<outline text="The world gets smaller!"/>				<outline text=""/>				<outline text="UK plug converters here"/>				<outline text="http://www.powerconnections.co.uk/convert_eurotouk.htm"/>				<outline text="And"/>				<outline text="http://www.euronetwork.co.uk/acatalog/Mains_adapters.html"/>				<outline text=""/>				<outline text=""/>				<outline text="Your local TV shop will tweak your TVs to UK standard"/>				<outline text=""/>				<outline text="You can buy ES bulbs of all types - so you can keep your lamps"/>				<outline text=""/>				<outline text="Why the funny plugs, bulbs and TV?"/>				<outline text=""/>				<outline text="Logie Baird invented the TV - Nationality British"/>				<outline text="Joseph Swan demonstrated the electric light a year before Edison -"/>				<outline text="Nationality British"/>				<outline text="William Gilbert coined the word electricity - - Nationality British"/>				<outline text=""/>				<outline text="UK Boing over"/>				<outline text=""/>				<outline text="Dave"/>				<outline text=""/>				<outline text="********************************************************"/>				<outline text="The main site is at http://www.raven.dj/"/>				<outline text="Suellen's  therapy site  is at http://www.riversidetherapy.com/"/>				<outline text="********************************************************"/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				</outline>			<outline text="Comment about dutch plugs">				<outline text="New comment posted on your Radio weblog."/>				<outline text=""/>				<outline text="Commenter's name: "/>				<outline text="Mike"/>				<outline text=""/>				<outline text="Email address: "/>				<outline text="holland042@hotmail.com"/>				<outline text=""/>				<outline text="Web site: "/>				<outline text=""/>				<outline text="IP address: "/>				<outline text="217.43.202.93"/>				<outline text=""/>				<outline text="Domain name: "/>				<outline text="host217-43-202-93.range217-43.btcentralplus.com"/>				<outline text=""/>				<outline text="Commenting on: "/>				<outline text="http://www.blognewsnetwork.com/members/0000001/2004/11/27.html#a6906"/>				<outline text=""/>				<outline text=""/>				<outline text="Hi Adam, Welcome to the UK and congratulations on the Culture Show piece, I'm sure that will generate a lot of publicity for podcasting. Interested to listen to your comments about the differences in plugs and TV systems in different countries . . . here's one for you :-) can you explain why all electric sockets are half up the wall in Holland?, that's always puzzled me!, why not have them at floor level like over here so they are not so obvious. Very much enjoy the podcasts, keep up the good work, - Mike"/>				</outline>			<outline text="TV solutions">				<outline text="New comment posted on your Radio weblog."/>				<outline text=""/>				<outline text="Commenter's name: "/>				<outline text="Toby Jaffey"/>				<outline text=""/>				<outline text="Email address: "/>				<outline text="toby-blog@earth.li"/>				<outline text=""/>				<outline text="Web site: "/>				<outline text=""/>				<outline text="IP address: "/>				<outline text="83.104.55.179"/>				<outline text=""/>				<outline text="Domain name: "/>				<outline text="pantheon.demon.co.uk"/>				<outline text=""/>				<outline text="Commenting on: "/>				<outline text="http://radio.weblogs.com/0001014/categories/dailySourceCode/2004/11/27.html#a6906"/>				<outline text=""/>				<outline text=""/>				<outline text="Hi, I think the reason that you can't hear the UK audio on your TVs is that the rest of Europe use PAL G/B/H for UHF (5.5mhz audio offset), whereas the UK, South Africa, Ireland and and Hong Kong use PAL-I which has a 6mhz offset for th  e the audio. I'm not sure why PAL-I does this, but basically it means that for RF reception you're not going to hear the audio. One way around it might be to get a Freeview (DVB-T) box which will put out SCART (where you get CVBS, audio L/R) which your TV should be able to deal with.  Ok, so I rose to the challenge of being a TV nerd, this is what 3 years working for a Set-Top-Box company does for you :)"/>				</outline>			</outline>		<outline text="BBC about podcasting">			<outline text="New comment posted on your Radio weblog."/>			<outline text=""/>			<outline text="Commenter's name: "/>			<outline text="Ross"/>			<outline text=""/>			<outline text="Email address: "/>			<outline text="rossdjones@gmail.com"/>			<outline text=""/>			<outline text="Web site: "/>			<outline text=""/>			<outline text="IP address: "/>			<outline text="80.5.160.8"/>			<outline text=""/>			<outline text="Domain name: "/>			<outline text="bagu-cache-5.server.ntli.net"/>			<outline text=""/>			<outline text="Commenting on: "/>			<outline text="http://www.blognewsnetwork.com/members/0000001/2004/11/27.html#a6906"/>			<outline text=""/>			<outline text=""/>			<outline text="Adam, the BBC got the URL right elsewhere ... looks like podcasting is gonna get another mention http://www.bbc.co.uk/6music/presenters/phill_jupitus/moreinfo.shtml  (Best of all I found a Rush interview on that page ;) Oops did I type that )."/>			</outline>		<outline text="mpeg of the culture show">			<outline text="Stuarts email">				<outline text="From: 	  Stuart Hunter &lt;shuntera@gmail.com&gt;"/>				<outline text="Subject: 	MPG BitTorrent of BBC Cultureshow on Podcasting"/>				<outline text="Date: 	November 28, 2004 12:07:15 AM GMT+00:00"/>				<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>				<outline text="Reply-To: 	  Stuart Hunter &lt;shuntera@gmail.com&gt;"/>				<outline text=""/>				<outline text="Adam,"/>				<outline text=""/>				<outline text="I have posted an mpeg version of the podcasting segment from the BBC,"/>				<outline text="some people were having problems with the mp4 version."/>				<outline text=""/>				<outline text="The bittorrent url is:"/>				<outline text=""/>				<outline text="http://torrent.youceff.com/torrents/CultureShowPodcasting.MPG.torrent"/>				<outline text=""/>				<outline text="Regards."/>				<outline text=""/>				<outline text="Stuart"/>				</outline>			</outline>		<outline text="The Grumet Family Players" artist="The Grumet Family Players" type="artist">			<outline text="Andrew Grumet's Audio Weblog" album="Andrew Grumet's Audio Weblog" artist="The Grumet Family Players" type="album">				<outline text="Freddie Freeloader" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:Freddie Freeloader.mp3" sizeFile="1131240" type="song" whenFileCreated="11/27/04; 10:46:45 PM"/>				</outline>			</outline>		<outline text="Sammelstelle">			<outline text="From: 	  Thomas Wanhoff &lt;thomas.wanhoff@gmx.de&gt;"/>			<outline text="Subject: 	promo from you"/>			<outline text="Date: 	November 27, 2004 1:20:33 PM GMT+00:00"/>			<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>			<outline text=""/>			<outline text="Hi Adam,, find attached a promo for you!"/>			<outline text="we are just two frequently podcasters in germany (also Nicole Simon with"/>			<outline text="useful sounds), and we talk it in english, so we can reach a bigger"/>			<outline text="audience...but we will not stop to promote it.."/>			<outline text=""/>			<outline text="Thanks for your show, i am listing every day when im driving to my office -"/>			<outline text="and sometime in my office while im working.."/>			<outline text=""/>			<outline text="all the best to you and your family"/>			<outline text="keep on podacasting!"/>			<outline text=""/>			<outline text="yours thomas"/>			<outline text=""/>			<outline text="-- "/>			<outline text="Thomas Wanhoff"/>			<outline text="www.sammelstelle.net"/>			<outline text="Music from germany"/>			</outline>		<outline text="Thomas Wanhoff" artist="Thomas Wanhoff" type="artist">			<outline text="Sammelstelle.net" album="Sammelstelle.net" artist="Thomas Wanhoff" type="album">				<outline text="Promo ESC from the world" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:promo_dailysource.mp3" sizeFile="286430" type="song" whenFileCreated="11/27/04; 11:43:35 PM"/>				</outline>			</outline>		<outline text="UPEI">			<outline text="email">				<outline text="Monsieur Curry,"/>				<outline text=""/>				<outline text=" "/>				<outline text=""/>				<outline text="Can¹t stop listening to your showŠ good stuff.  Just wanted to let you know that I am starting a new university Web-radio station/podcasting service over here at the University of Prince Edward Island in Canada.  Your show provides a lot of inspiration for it. Thought you might want to hear one of my ³experimental² uploads.  I just started fooling around a couple days back and came up with it.  I think this is the kind of stuff that might inspire more people to contribute.  Anyway, hope you get around to listening to it.  Thanks for everything, have a good one."/>				<outline text=""/>				<outline text=" "/>				<outline text=""/>				<outline text="~Justin Doiron (pronounced DerawnŠ accent on the awn)"/>				<outline text=""/>				<outline text="UPEI"/>				<outline text=""/>				<outline text="doironj@eastlink.ca"/>				</outline>			</outline>		<outline text="Digital Man" artist="Digital Man" type="artist">			<outline text="Digital Experience Podcast Promo1" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:podpromo.mp3" sizeFile="655869" type="song" whenFileCreated="11/27/04; 11:38:54 PM"/>			</outline>		<outline text="RIAA Free zone">			<outline text="email">				<outline text="From: 	  Todd M. Shrider &lt;tmshrider@gmail.com&gt;"/>				<outline text="Subject: 	New Podcast / Song"/>				<outline text="Date: 	November 25, 2004 5:10:42 AM GMT+00:00"/>				<outline text="To: 	  Adam Curry &lt;adam@curry.com&gt;"/>				<outline text="Reply-To: 	  Todd M. Shrider &lt;tmshrider@gmail.com&gt;"/>				<outline text=""/>				<outline text="Adam,"/>				<outline text=""/>				<outline text="I wanted to send you a link to my new podcast. It's basically going to"/>				<outline text="be a RIAA FREE zone. My first show is up and I am debuting an artist"/>				<outline text="by the name of Nathan Holscher. I have attached one of his songs. If"/>				<outline text="you like it, maybe you could plug the show for me. It's called &quot;The No"/>				<outline text="Man Show&quot; as in fuck the man, were RIAA free baby! You can find it at"/>				<outline text="www.studiogeek.org/rss.xml."/>				<outline text=""/>				<outline text="Thanks!"/>				<outline text=""/>				<outline text=""/>				<outline text="-- "/>				<outline text="todd m. shrider (studiogeek)"/>				<outline text="http://www.studiogeek.org"/>				<outline text="tmshrider@gmail.com"/>				</outline>			</outline>		<outline text="Coverville␀" artist="Coverville␀" type="artist">			<outline text="All Request Sunday␀" album="All Request Sunday␀" artist="Coverville␀" type="album">				<outline text="Coverville-2004-11-21␀" f="Macintosh HD:Users:adamcurry:Desktop:DSC-ShowPrep:Coverville-2004-11-21.mp3" sizeFile="31630547" type="song" whenFileCreated="11/27/04; 11:19:37 PM"/>				</outline>			</outline>		<outline text="Sports Node">			<outline text="email">				<outline text="From: 	  Curtis &lt;curtis@thesportspod.com&gt;"/>				<outline text="Subject: 	Re: sports.opml parsing correctly now?"/>				<outline text="Date: 	November 29, 2004 3:24:04 AM GMT+00:00"/>				<outline text="To: 	  'Adam Curry' &lt;adam@curry.com&gt;"/>				<outline text=""/>				<outline text="Woohooo!  i'll write a something up to assist for the future. I'm happy to"/>				<outline text="be a resource to help folks manage nodes going forward."/>				<outline text=""/>				<outline text="Adam, i just heard the last source code. I think you mistakently gave the"/>				<outline text="other sports podcast (skinny) credit for my ompl efforts over the last"/>				<outline text="month. he mentioned to me he hasn't ever touched the ipodder directory nor"/>				<outline text="opml.  I know it was a mistake, but it sort of hurt because of all the"/>				<outline text="effort I've made with the opml directory, and also the fact that I've sent"/>				<outline text="you a couple of clips in the past and haven't been able to get any play."/>				<outline text="Then this new guy, 2 podcasts in, gets the credit &amp; a plug."/>				<outline text=""/>				<outline text="I know you hate sports...  but I would be highly grateful if you could"/>				<outline text="mention thesportspod on the source code. I focused on entrepreurism getting"/>				<outline text="my mba at mit, and am actively applying my experience and effort to the"/>				<outline text="podcasting movement, because it fires me up!"/>				<outline text=""/>				<outline text="Considering that you deal with 100s of emails per day, let's just make sure:"/>				<outline text="I'm Curtis... of the sportspod at thesportspod.com  :)"/>				<outline text=""/>				<outline text="I shrank the one hour Fri, Nov 26th podcast into a short montage. I made a 3"/>				<outline text="minute version, and 5 minute version to give you flexibility."/>				<outline text="3 minutes: http://podcat.com/podcasts/sportspod/sportspodwithcurtis3min.mp3"/>				<outline text="5 minutes: http://podcat.com/podcasts/sportspod/sportspodwithcurtis5min.mp3"/>				<outline text=""/>				<outline text="Since you're connected with the dutch version of the apprentice, I'll"/>				<outline text="mention that there is a bit of non-sports talk on the american version of"/>				<outline text="the apprentice. My material would not get by the FCC."/>				<outline text=""/>				<outline text="About the SportsPod"/>				<outline text="-web site: www.thesportspod.com"/>				<outline text="-tagline: sports talk on demand through podcast technology"/>				<outline text="-mission: to inform, educate, and entertain our subscribers about the world"/>				<outline text="of sports through reporting, commentary, and satire, and to build a caller"/>				<outline text="driven sports talk radio community through podcast technology."/>				<outline text="-frequency &amp; duration: 2 to 3 podcasts per week, average of 40 minutes"/>				<outline text="-run by Curtis, a wacko sports fanatic who sings his own theme song, and"/>				<outline text="also plays the role of podcat on podcat's daily best of podcasting"/>				<outline text="(www.podcat.com and www.podcat.com/links)"/>				<outline text="-the sportspod just celebrated it's one month anniverssary..woohoo! and has"/>				<outline text="published 14 podcasts in that time"/>				<outline text="-what's new: in the flavor of openpodcast.org, the sportspod takes calls"/>				<outline text="through a voice mail line and (mp3) email, and posts them to the rss feed"/>				<outline text="throughout the day; this can be thought of as a bulletin board like yahoo"/>				<outline text="groups, but for audio. Calls are posted to the rss feed within 15 minutes of"/>				<outline text="their occurence, giving sports fans the immidiacy necessary to respond to"/>				<outline text="each other and up-to-the-minute sporting events."/>				<outline text=""/>				<outline text="Thanks Adam! I'll help out more anywhere you need it."/>				<outline text=""/>				<outline text="/curtis"/>				<outline text="www.thesportspod.com"/>				<outline text="www.podcat.com"/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				<outline text="-----Original Message-----"/>				<outline text="From: Adam Curry [mailto:adam@curry.com] "/>				<outline text="Sent: Sunday, November 28, 2004 5:32 PM"/>				<outline text="To: Curtis"/>				<outline text="Subject: [SPAM] Re: sports.opml parsing correctly now?"/>				<outline text=""/>				<outline text="Boiinngg!"/>				<outline text=""/>				<outline text="It worked"/>				<outline text=""/>				<outline text="AC"/>				<outline text=""/>				<outline text="On Nov 28, 2004, at 1:20 AM, Curtis wrote:"/>				<outline text=""/>				<outline text="http://www.thesportspod.com/opml/sports.opml"/>				<outline text=""/>				<outline text="ok, I downloaded radio userland, and made the updates... moved it "/>				<outline text="around and"/>				<outline text="was able to open again in radiouserland... so should be good to go...."/>				<outline text="keeping my fingers tightly crossed."/>				<outline text=""/>				<outline text="/curtis"/>				<outline text=""/>				<outline text="-----Original Message-----"/>				<outline text="From: Adam Curry [mailto:adam@curry.com]"/>				<outline text="Sent: Saturday, November 27, 2004 4:32 PM"/>				<outline text="To: Curtis"/>				<outline text="Subject: [SPAM] Re: [SPAM] Re: sports.opml parsing correctly now?"/>				<outline text=""/>				<outline text="Hey, looks like you have some weird characters at the beginning of the"/>				<outline text="file."/>				<outline text=""/>				<outline text="THis doesn't even open as an outline."/>				<outline text=""/>				<outline text="You can also try a 30 day trial of Radio Userland. All it's native"/>				<outline text="outline documents are opml"/>				<outline text="radio.userland.com"/>				<outline text=""/>				<outline text=""/>				<outline text="AC"/>				<outline text=""/>				<outline text="On Nov 28, 2004, at 12:04 AM, Curtis wrote:"/>				<outline text=""/>				<outline text="&lt;sports.opml&gt;"/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				<outline text=""/>				</outline>			<outline text="The SportsPod OPML notes" type="link" url="www.thesportspod.com/opml/sportspod.opml"/>			</outline>		</body>	</opml>